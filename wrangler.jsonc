{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gptimage",
  "main": "./worker.js",
  "compatibility_date": "2026-05-07",
  "vars": {
    "VITE_API_PROXY_AVAILABLE": "true",
    "VITE_API_PROXY_LOCKED": "true"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
